# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME=SWK Stock Management
APP_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=swk
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=swk_stock
POSTGRES_PORT=5433

# Prisma
DATABASE_URL=postgresql://swk:change_me_strong_password@localhost:5433/swk_stock?schema=public

# JWT — generate a long random secret for production
JWT_SECRET=change_me_generate_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_generate_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Public receiving links
RECEIVING_TOKEN_TTL_HOURS=168
RECEIVING_PUBLIC_BASE_URL=http://localhost:3001/receive

# Seed (development only — do not use real client credentials)
SEED_ADMIN_EMAIL=admin@swk.local
SEED_ADMIN_PASSWORD=Admin@SWK2026!
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
